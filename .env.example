# MotionLens environment template.
# Copy to .env for local development and replace placeholder values as needed.

# Backend URLs
# MLIVE_BACKEND_BASE_URL is used by the Streamlit UI for server-side API calls.
# MLIVE_PUBLIC_BACKEND_URL is used for QR/mobile capture links.
MLIVE_BACKEND_BASE_URL=http://localhost:8000
MLIVE_PUBLIC_BACKEND_URL=http://YOUR-LAN-IP-OR-DOMAIN:8000

# Local development convenience.
# Set to 0 in any real deployment behind HTTPS.
MLIVE_ALLOW_INSECURE_LOCAL=1

# Store / worker runtime
MLIVE_STORE_BACKEND=memory
MLIVE_REDIS_URL=redis://localhost:6379/0
MLIVE_REDIS_PREFIX=mlive
MLIVE_MAX_RAW_POINTS=6000
MLIVE_MAX_QUEUE_TASKS=2000
MLIVE_MAX_HISTORY_ENTRIES=2000
MLIVE_WORKER_POLL_SECONDS=0.05